VnVector4_LREAL),ARRAY (ARRAY [0..3] OF LREAL)"],[19,"a46ce5b1-6ff2-43e9-b350-941730dcd957",1,"8a80992d-a90d-432a-80bf-e5e3d6a91313",1,"INTERFACE (ITcVnContainer)"],[20,"28ac4f02-3d05-4d0e-a045-5436341dd397",1,"8a80992d-a90d-432a-80bf-e5e3d6a91313",2,"INTERFACE (ITcVnImage)"],[21,"5195f176-fb97-421d-baaf-3a7735487103",1,"8a80992d-a90d-432a-80bf-e5e3d6a91313",3,"ALIAS (TcVnVector4_LREAL),ARRAY (ARRAY [0..3] OF LREAL)"],[22,"8a80992d-a90d-432a-80bf-e5e3d6a91313",1,"3b38c8c1-f360-4765-9ac0-65660649d0f4",1,"INTERFACE (ITcVnImage)"],[23,"e3215b00-f823-4f19-a10b-6a2eb5d7a215",1,"8cc98d47-9281-46a6-8e33-f54ea99650a2",1,"STRUCT (TcVnRectangle_UDINT)"]],"groups":[{"id":1,"title":"1. Fuse line-scan frames (F_VN_FuseImagesArray)","bounding":[584,202.69998168945312,1268,1020.6000366210938],"color":"#3f789e","font_size":24,"flags":{},"description":"A line-scan camera delivers a long part as a series of frames (here 4 x 640x120). \nF_VN_FuseImagesArray joins up to 10 frames vertically into one image. nValidImages = how many inputs are wired, nFirstLine = first line of frame 1 to keep, nNumLines = total lines in the result (here all 480). Neither the bar's length nor the centre hole (split across frames 2 and 3) can be measured from any single frame."},{"id":2,"title":"3. Find the holes","bounding":[1594,1293.7000732421875,1498.40234375,627.5999755859375],"color":"#3f789e","font_size":24,"flags":{},"description":"Hough circles on the fused image finds all three holes, including the large centre hole that is only a half-circle in each of frames 2 and 3."},{"id":3,"title":"4. Draw the result","bounding":[1594,1991.7000732421875,1829.21142578125,411.6000061035156],"color":"#3f789e","font_size":24,"flags":{},"description":"Bar outline in green, holes in magenta, on the fused image."},{"id":4,"title":"2. Measure the whole bar","bounding":[1594,2473.699951171875,1875.4208984375,269.6000061035156],"color":"#3f789e","font_size":24,"flags":{},"description":"Threshold, outline and upright bounding box of the fused bar: nHeight is the bar length in pixels (lines), which spans all four frames."}],"config":{},"extra":{"filemeta":{"name":"Stitch Line-Scan Frames with FuseImagesArray","description":"This example joins four line-scan camera frames into one image with F_VN_FuseImagesArray so that a long part can be measured as a whole.","tags":["Image Stitching","Measurement","Line Scan","Metalworking"]},"__aiIds":{"7f822ad8-dce8-4c60-aefb-b49c74958364":"f0","93846935-0c09-486b-adc8-4d23129448f1":"f1","63075d98-0fd5-4b5f-bb98-d79f8175f16a":"f2","d14df34f-54c6-47ab-bb14-6290316315c5":"f3","d78ef7eb-c55b-432e-b981-d11be53f8eba":"fuse","5be7d815-a368-411b-a44d-eae8065d408a":"showFused","60b59106-70b3-4b86-83fd-30dd2f42fabc":"thr","8011ed2e-e203-4a1a-ab21-54ca2b600f4b":"cont","795555c0-7ecd-4d49-a405-41a7fb1efa56":"bar","e3215b00-f823-4f19-a10b-6a2eb5d7a215":"rect","beeb4026-4f12-4e66-82a4-afbbe1a42912":"blur","a46ce5b1-6ff2-43e9-b350-941730dcd957":"hough","8afae2a2-f90e-4d19-b90a-aa2678d39fbd":"nHoles","aa306d46-5ff1-4a4d-b935-3845c570ca15":"showN","3cd1f090-ccd3-414a-a1de-f5dbf22e0c04":"showHoles","779ad10a-e960-471d-a285-8dd7f09e949a":"rgb","f6fe43a0-4101-4766-ae92-5b8205c494c8":"cGreen","5195f176-fb97-421d-baaf-3a7735487103":"cMagenta","28ac4f02-3d05-4d0e-a045-5436341dd397":"drawBar","8a80992d-a90d-432a-80bf-e5e3d6a91313":"drawHoles","3b38c8c1-f360-4765-9ac0-65660649d0f4":"out","8cc98d47-9281-46a6-8e33-f54ea99650a2":"showBox"},"annotations_plugin":[],"ds":{"scale":0.3324173854961816,"offset":[631.8922414603587,302.34319198242787]}},"version":0.4,"uuid":"81f95046-2b19-4d8d-a738-fd3d475e7318"}