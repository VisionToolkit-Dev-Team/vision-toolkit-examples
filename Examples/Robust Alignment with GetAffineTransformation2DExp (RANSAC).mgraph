,[23,"6aff9bfa-c002-4bfd-9606-a140ba9eadcb",1,"816e97ef-3df2-4a81-993a-58fe789531a0",2,"ALIAS (TcVnMatrix2x3_LREAL),ARRAY (ARRAY [0..1,0..2] OF LREAL)"],[24,"ff1bf99c-1fbd-47ce-a9aa-d52185272f06",1,"ccf533ce-0ab3-4906-be92-cba097b7ab89",1,"INTERFACE (ITcVnImage)"],[25,"c09f9768-f269-4846-a840-6c6ac8b0c8a6",1,"ccf533ce-0ab3-4906-be92-cba097b7ab89",2,"ALIAS (TcVnMatrix2x3_LREAL),ARRAY (ARRAY [0..1,0..2] OF LREAL)"],[26,"eb0fb303-fb98-48a0-ab0d-e71524cb5c1c",1,"8ef6a53a-89cb-41ac-aafd-616c0b20837b",1,"INTERFACE (ITcVnContainer)"],[27,"5ab52931-bedd-45df-9dbb-0922765e8796",1,"8ef6a53a-89cb-41ac-aafd-616c0b20837b",3,"STRUCT (GUID)"],[28,"816e97ef-3df2-4a81-993a-58fe789531a0",1,"4c370066-9ea9-42df-b76d-598b95b050f3",1,"INTERFACE (ITcVnImage)"],[29,"ccf533ce-0ab3-4906-be92-cba097b7ab89",1,"93b0ede0-ca02-4830-b624-a4469ecb7909",1,"INTERFACE (ITcVnImage)"],[30,"8ef6a53a-89cb-41ac-aafd-616c0b20837b",1,"c4316f9c-2de2-4c52-840d-4644ee6f0a6e",1,"INTERFACE (ITcVnContainer)"],[31,"4c370066-9ea9-42df-b76d-598b95b050f3",1,"c4316f9c-2de2-4c52-840d-4644ee6f0a6e",2,"INTERFACE (ITcVnImage)"],[32,"ca197e03-3f8b-436b-94ad-05f83b736511",1,"c4316f9c-2de2-4c52-840d-4644ee6f0a6e",3,"ALIAS (TcVnVector4_LREAL),ARRAY (ARRAY [0..3] OF LREAL)"],[33,"8ef6a53a-89cb-41ac-aafd-616c0b20837b",1,"05d70252-062e-49f3-9a76-f0ef9fbf71dc",1,"INTERFACE (ITcVnContainer)"],[34,"93b0ede0-ca02-4830-b624-a4469ecb7909",1,"05d70252-062e-49f3-9a76-f0ef9fbf71dc",2,"INTERFACE (ITcVnImage)"],[35,"ca197e03-3f8b-436b-94ad-05f83b736511",1,"05d70252-062e-49f3-9a76-f0ef9fbf71dc",3,"ALIAS (TcVnVector4_LREAL),ARRAY (ARRAY [0..3] OF LREAL)"],[36,"c4316f9c-2de2-4c52-840d-4644ee6f0a6e",1,"42aba325-74da-414a-8917-2c3c540f04f9",1,"INTERFACE (ITcVnImage)"],[37,"05d70252-062e-49f3-9a76-f0ef9fbf71dc",1,"a3cc14e5-9988-4c9a-b83a-7c3b8c2eda42",1,"INTERFACE (ITcVnImage)"]],"groups":[{"id":1,"title":"1. Measure the 5 markers","bounding":[78.74635314941406,-110.80734252929688,2373.510986328125,677.6000366210938],"color":"#3f789e","font_size":24,"flags":{},"description":"Inverted threshold keeps the black markers; F_VN_ConnectedComponentsWithStats gives their centres (raster order A, B, C, D, E for this board); F_VN_EraseFromContainer drops label 0, the background. The ink smear joined to marker C drags its measured centre about 50 px to the right - a bad point that a plain fit would trust."},{"id":2,"title":"2. Where the markers should be","bounding":[-470,1350,3209.472900390625,393.6001281738281],"color":"#3f789e","font_size":24,"flags":{},"description":"Reference positions of A..E on the board drawing, in the same order as the measured centres."},{"id":3,"title":"3. Fit with and without outlier rejection (F_VN_GetAffineTransformation2DExp)","bounding":[3040,-90,805.229736328125,1275.60009765625],"color":"#3f789e","font_size":24,"flags":{},"description":"New in vision pack 0.12: F_VN_GetAffineTransformation2DExp estimates rotation, scale, shear and shift from 3 or more point pairs. With RANSAC and fReprojThreshold 3 px it flags any pair that does not fit within 3 px - the inlier mask comes back [1,1,0,1,1], rejecting smudged marker C - and fits on the other four. With the threshold at 1000 px every point is trusted and the smudge bends the fit. F_VN_WarpAffine then maps each board onto the drawing."},{"id":4,"title":"4. Check the alignment","bounding":[2902.23828125,1255.192626953125,2241.185546875,495.6000061035156],"color":"#3f789e","font_size":24,"flags":{},"description":"Red + marks show where each marker should be. RANSAC: all five sit exactly on their markers (even C, whose true centre is under the smudge). Trust all: the marks miss."}],"config":{},"extra":{"filemeta":{"name":"Robust Alignment with GetAffineTransformation2DExp (RANSAC)","description":"This example aligns a board to its drawing from five alignment markers, one of which is spoiled by an ink smear, using F_VN_GetAffineTransformation2DExp.","tags":["Fiducial Registration","Outlier Rejection","Alignment","Robotics"]},"__aiIds":{"ff1b