d43",1,"06b5e36d-5563-4bc3-a0cb-9a0bfff23163",2,"INTERFACE (ITcVnContainer)"],[13,"25217dd2-c68a-4a4d-809f-806719e61ea2",1,"06b5e36d-5563-4bc3-a0cb-9a0bfff23163",1,"ALIAS (TcVnPoint2_REAL),ALIAS (TcVnVector2_REAL),ARRAY (ARRAY [0..1] OF REAL)"],[14,"06b5e36d-5563-4bc3-a0cb-9a0bfff23163",1,"2293daee-b464-4f07-b58b-2555156ec209",2,"INTERFACE (ITcVnContainer)"],[15,"8091a7d7-1684-4ddf-83d1-ed5ec679586b",1,"2293daee-b464-4f07-b58b-2555156ec209",1,"ALIAS (TcVnPoint2_REAL),ALIAS (TcVnVector2_REAL),ARRAY (ARRAY [0..1] OF REAL)"],[16,"34a5a42b-737c-4109-85fb-2e5b522ccd81",1,"3cba2d5a-8871-46e3-a50b-0491adcca6c9",1,"INTERFACE (ITcVnContainer)"],[17,"2293daee-b464-4f07-b58b-2555156ec209",1,"3cba2d5a-8871-46e3-a50b-0491adcca6c9",2,"INTERFACE (ITcVnContainer)"],[18,"3cba2d5a-8871-46e3-a50b-0491adcca6c9",1,"c4ab73e7-7558-49e9-9ee3-4f4820f29721",1,"ALIAS (TcVnMatrix3x3_LREAL),ARRAY (ARRAY [0..2,0..2] OF LREAL)"],[19,"97ae9051-5c9f-42a4-8f32-0c7c7e170305",1,"81a8eac1-1b67-4cef-82bb-32577475aef5",1,"INTERFACE (ITcVnImage)"],[20,"3cba2d5a-8871-46e3-a50b-0491adcca6c9",1,"81a8eac1-1b67-4cef-82bb-32577475aef5",2,"ALIAS (TcVnMatrix3x3_LREAL),ARRAY (ARRAY [0..2,0..2] OF LREAL)"],[21,"81a8eac1-1b67-4cef-82bb-32577475aef5",1,"14d30dd0-2a31-42da-88c8-27a95e0a0ab3",1,"INTERFACE (ITcVnImage)"]],"groups":[{"id":1,"title":"1. Find the 4 corner markers","bounding":[584,41.29999542236328,2768.133544921875,807.6000366210938],"color":"#3f789e","font_size":24,"flags":{},"description":"Only the black markers survive an inverted threshold at 40. F_VN_ConnectedComponentsWithStats returns every blob's centroid, with the background as label 0, which F_VN_EraseFromContainer removes. F_VN_ConvertContainerType turns the Point2_LREAL centroids into the Point2_REAL list the homography expects. Centroids come in raster order (top-most first): top-right, top-left, bottom-right, bottom-left for this card."},{"id":2,"title":"2. Where the markers should be","bounding":[1304,919.300048828125,1978.328369140625,393.6000061035156],"color":"#3f789e","font_size":24,"flags":{},"description":"The same four markers on a flat, upright card, listed in the SAME order as the measured centres: top-right, top-left, bottom-right, bottom-left. Built by appending points to an empty Point2_REAL container."},{"id":3,"title":"3. Straighten (F_VN_HomographyExp)","bounding":[3384.133544921875,41.29999542236328,934.079833984375,564.6000366210938],"color":"#3f789e","font_size":24,"flags":{},"description":"F_VN_HomographyExp finds the 3x3 perspective matrix that maps the measured points onto the reference points (4 or more pairs; RANSAC/LMEDS can reject bad points when you have more). F_VN_WarpPerspective applies it, giving a flat, upright card ready for reading or inspection."}],"config":{},"extra":{"filemeta":{"name":"Straighten a Skewed Card with HomographyExp","description":"This example straightens a card photographed at an angle using F_VN_HomographyExp, with F_VN_EraseFromContainer and F_VN_ConvertContainerType.","tags":["Perspective Correction","Alignment","Preprocessing for Inspection","Packaging","Electronics"]},"__aiIds":{"97ae9051-5c9f-42a4-8f32-0c7c7e170305":"img","2ad66739-ecb8-4483-8fc5-69b98ec33c5b":"thr","59069999-0d9c-4220-a601-9ce032fed1dc":"cc","6bddaab1-fb69-4e16-8049-901af1d13477":"erase","5dd72881-6280-4e22-8923-47f3b3260767":"ctype","34a5a42b-737c-4109-85fb-2e5b522ccd81":"toReal","ce3be72b-2651-403b-8d1d-79726d61fdb7":"showSrc","79bd648e-83e5-4e80-af06-3fb836c27f61":"ref","29121834-176e-4f7a-805b-a38e9512a41a":"pTR","1faa5c21-e47e-4693-ac45-8e8f313b3372":"pTL","25217dd2-c68a-4a4d-809f-806719e61ea2":"pBR","8091a7d7-1684-4ddf-83d1-ed5ec679586b":"pBL","a081a19a-3601-419b-8488-66f9654958ef":"a1","0bedabb5-404a-4816-8504-2c58326aed43":"a2","06b5e36d-5563-4bc3-a0cb-9a0bfff23163":"a3","2293daee-b464-4f07-b58b-2555156ec209":"a4","3cba2d5a-8871-46e3-a50b-0491adcca6c9":"homo","c4ab73e7-7558-49e9-9ee3-4f4820f29721":"showH","81a8eac1-1b67-4cef-82bb-32577475aef5":"warp","14d30dd0-2a31-42da-88c8-27a95e0a0ab3":"out"},"annotations_plugin":[],"ds":{"scale":0.9229599817706429,"offset":[-2918.44852622227,143.4740286036376]}},"version":0.4,"uuid":"cd292f8a-5d43-48d9-9908-767960eca59e"}