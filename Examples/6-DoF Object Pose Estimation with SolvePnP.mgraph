556e4ef8-85eb-445e-91fa-e99886a2896b",1,"BOOL"],[228,"ad819250-ec73-4e2a-ac1c-909d6dc415a5",1,"432c3891-c58e-4fbd-bebb-39fd4ca2f3b5",1,"BOOL"],[229,"ad819250-ec73-4e2a-ac1c-909d6dc415a5",1,"343ae6cf-42b7-4fd6-b126-cb3640ea8abe",1,"BOOL"],[230,"ad819250-ec73-4e2a-ac1c-909d6dc415a5",1,"f7a53384-24b7-434a-a018-cacfd185713b",1,"BOOL"],[231,"ad819250-ec73-4e2a-ac1c-909d6dc415a5",1,"43dfd80f-24ad-42b2-9558-32cf88b52188",1,"BOOL"],[232,"ad819250-ec73-4e2a-ac1c-909d6dc415a5",1,"e7073bbc-73fb-46ee-b574-5bb6f355ca30",1,"BOOL"],[233,"ad819250-ec73-4e2a-ac1c-909d6dc415a5",1,"6db43a01-e931-47f0-a7ab-e3c8c1fd4b94",1,"BOOL"],[234,"ad819250-ec73-4e2a-ac1c-909d6dc415a5",1,"6642da7f-7899-4a33-ac74-e1afafade438",1,"BOOL"],[235,"ad819250-ec73-4e2a-ac1c-909d6dc415a5",1,"2ecfc26e-0a8b-48bf-8db3-7d9f7780ef6f",1,"BOOL"],[236,"dc225691-88c3-4431-a71f-24eaae8e90a5",1,"f5609410-bd8c-4d1c-b8e7-2420de9d4e95",1,"INTERFACE (ITcVnImage)"],[237,"f5609410-bd8c-4d1c-b8e7-2420de9d4e95",1,"ced2e38b-2a8f-49fa-9c21-db52c770842b",2,"INTERFACE (ITcVnImage)"],[238,"19fc5de0-751c-4a49-ac16-cabf3a5a85cc",1,"ced2e38b-2a8f-49fa-9c21-db52c770842b",3,"ALIAS (TcVnVector4_LREAL),ARRAY (ARRAY [0..3] OF LREAL)"]],"groups":[{"id":15,"title":"01 | Select the object pose","bounding":[-24,-135.60000610351562,1331.4849853515625,959.1351318359375],"color":"#447d97","font_size":24,"flags":{},"description":"Change 'Select B?' to FALSE for Pose A or TRUE for Pose B. The same control switches the synthetic camera image and the five corresponding 2D measured points. A copy and brightness reduction make the subsequent overlays clear."},{"id":16,"title":"02 | Known 3D object geometry","bounding":[1426,-115.5999984741211,3098,512.5999755859375],"color":"#9a7d53","font_size":24,"flags":{},"description":"Build five reference markers in the plate coordinate system, in millimetres: P0=(0,0,0), P1=(100,0,0), P2=(100,60,0), P3=(0,60,0), P4=(30,20,0). The ordered 3D points stay unchanged when the pose switches."},{"id":17,"title":"03 | Corresponding 2D image points","bounding":[1426,604.4000244140625,3098,512.5999755859375],"color":"#4b937f","font_size":24,"flags":{},"description":"The five observed pixel coordinates use the SAME P0–P4 order as the physical model. Their X/Y values are selected by the shared Pose A/B control in Support B. The resulting TcVnPoint2_REAL container feeds SolvePnP."},{"id":18,"title":"04 | Simulated camera parameters","bounding":[4576,265.3999938964844,518,448.6000061035156],"color":"#8775ad","font_size":24,"flags":{},"description":"Provide the camera intrinsics (fx=fy=900 pixels, principal point 400,300) and zero distortion. These are hypothetical parameters for this synthetic example, not calibration data measured from a physical camera."},{"id":19,"title":"05 | Compute 6-DoF pose with SolvePnP","bounding":[5228.61572265625,-131.11273193359375,673.43701171875,858.5999755859375],"color":"#ae8050","font_size":24,"flags":{},"description":"F_VN_SolvePnP takes ordered 3D model points, matching 2D image points and camera parameters. The translation vector locates the plate origin (mm), the rotation matrix describes its orientation, and reprojection error reports agreement in pixels."},{"id":20,"title":"06 | Reproject to verify the pose","bounding":[6126,100.39999389648438,908,536.5999755859375],"color":"#5b83a1","font_size":24,"flags":{},"description":"Project the known 3D plate markers back to 2D pixels using the calculated rotation, translation and same camera parameters. The projected points should agree closely with the supplied observed points. This checks geometric consistency, not independent camera calibration accuracy."},{"id":21,"title":"07 | Result: points and RGB pose axes","bounding":[7096,-25.600000381469727,2320.7197265625,840.6395263671875],"color":"#428c89","font_size":24,"flags":{},"description":"Final image: YELLOW rings = supplied 2D observations; MAGENTA crosses = reprojected model markers. RED, GREEN and BLUE lines show positive object X, Y and Z axes (25 mm each) from the plate origin. Switch Pose A/B to see both position and orientation change."},{"id":22,"title":"Support A | LREAL model for reprojection","bounding":[1426,1434.4000244140625,3098,512.5999755859375],"color":"#8894aa","font_size":24,"flags":{},"description":"F_VN_SolvePnP uses 3D points of type TcVnPoint3_REAL; the world-to-image projection function expects TcVnPoint3_LREAL. This duplicates the identical five millimetre coordinates with the required precision. Not a second physical model."},{"id":23,"title":"Support B | Synchronised Pose A/B point selection","bounding":[1426,2224.39990234375,3353.00927734375,671.5999755859375],"color":"#789c70","font_size":24,"flags":{},"description":"Each of the five 2D marker coordinates has a paired A and B alternative. SEL_REAL functions use the SAME Boolean control as the image Mux, so the selected pixel positions always match the displayed plate pose. These feed Group 03."},{"id":24,"title":"Support C | Define the 3D RGB reference axes","bounding":[4620.78662109375,1434.4000244140625,2160.98095703125,490.6000061035156],"color":"#b38d67","font_size":24,"flags":{},"description":"Four 3D model-frame coordinates in mm: origin (0,0,0); +X (25,0,0); +Y (0,25,0); +Z (0,0,25). The orientation is obtained from SolvePnP, not encoded in these reference points."},{"id":25,"title":"Support D | Project RGB axes and extract pixels","bounding":[6869.1875,1216.1500244140625,2639.70703125,797.5999755859375],"color":"#72919e","font_size":24,"flags":{},"description":"Transform the model-frame origin and three axis ends to 2D with the solved pose. Extract each projected point, split X and Y, then convert to UDINT pixel positions for the three F_VN_DrawLineExp nodes in Group 07."}],"config":{},"extra":{"__aiIds":{"b26c3c7d-1ed4-421f-ab5c-1f4ab720d3a4":"sampleImage","3978f52e-a824-4cb2-a574-74a046faee74":"sourceDisplay","dc225691-88c3-4431-a71f-24eaae8e90a5":"copy","76b2f706-dcc5-4925-9bec-3526e5e0e2b5":"modelType","5b16479e-e2d6-4