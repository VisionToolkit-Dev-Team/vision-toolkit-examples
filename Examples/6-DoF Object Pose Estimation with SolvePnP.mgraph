bd1cf":"poseAUnbundle4","8054a8fc-c72c-44c7-8fec-f2d426de18fc":"poseBUnbundle4","6642da7f-7899-4a33-ac74-e1afafade438":"poseSelectX4","2ecfc26e-0a8b-48bf-8db3-7d9f7780ef6f":"poseSelectY4","0e942ee8-7e69-48af-9994-b40541a82b51":"posePoint4","b9badb8a-6bcf-4e0e-8016-c6f44bf243d2":"Node_16","f5609410-bd8c-4d1c-b8e7-2420de9d4e95":"Node_24","ad819250-ec73-4e2a-ac1c-909d6dc415a5":"Node_15","19fc5de0-751c-4a49-ac16-cabf3a5a85cc":"Node_23"},"filemeta":{"name":"6-DoF Object Pose Estimation with SolvePnP","description":"This example demonstrates how TwinCAT Vision's F_VN_SolvePnP calculates the 3D position and orientation of an object from five corresponding 2D image points and known 3D reference coordinates.\n\nA simulated rectangular plate is presented in two different poses, selectable using a single Boolean control. The example uses predefined image points, known object dimensions and simulated camera calibration parameters to calculate a rotation matrix and translation vector.\n\nThe calculated pose is used to reproject the reference points onto the original image and display three colour-coded coordinate axes (Red X, Green Y and Blue Z), providing an intuitive visual representation of the object's orientation.\n\nReprojection error is displayed to demonstrate the accuracy of the geometric fit.\n\nKey learning objectives:\n\nUnderstand 2D-to-3D point correspondence.\n\nInterpret rotation matrices and translation vectors.\n\nVisualise 3D orientation using projected coordinate axes.\n\nUnderstand reprojection and its role in pose verification.\n\nCompare pose calculations for two different object orientations.\n\nThe example uses synthetic images and predefined feature coordinates to focus on pose estimation rather than feature detection. Real-world applications require calibrated camera parameters and reliable point detection.","tags":["TwinCAT Vision","SolvePnP","6-DoF","Pose Estimation","3D Geometry","Camera Calibration","Coordinate Transformation","Reprojection","Object Orientation","Machine Vision"]},"annotations_plugin":[],"ds":{"scale":0.27761535464531034,"offset":[-4437.782354125794,670.0555384718455]},"reroutes":[{"id":8,"pos":[7381.107421875,-267.1965026855469],"linkIds":[225,226,227,228,229,230,231,232,233,234,235]},{"id":9,"parentId":8,"pos":[-167.47840881347656,-212.5785369873047],"linkIds":[225,226,227,228,229,230,231,232,233,234,235]},{"id":11,"parentId":9,"pos":[-281.67803955078125,3107.433837890625],"linkIds":[226,227,228,229,230,231,232,233,234,235]},{"id":12,"parentId":11,"pos":[1343.8289794921875,3103.48583984375],"linkIds":[226,227,228,229,230,231,232,233,234,235]},{"id":13,"parentId":12,"pos":[2098.76171875,3100.27392578125],"linkIds":[228,229,230,231,232,233,234,235]},{"id":14,"parentId":13,"pos":[2868.47900390625,3098.98681640625],"linkIds":[230,231,232,233,234,235]},{"id":15,"parentId":14,"pos":[3555.4951171875,3089.9599609375],"linkIds":[232,233,234,235]},{"id":16,"parentId":15,"pos":[4179.5439453125,3072.57861328125],"linkIds":[234,235]}],"linkExtensions":[{"id":225,"parentId":9},{"id":226,"parentId":12},{"id":227,"parentId":12},{"id":228,"parentId":13},{"id":229,"parentId":13},{"id":230,"parentId":14},{"id":231,"parentId":14},{"id":232,"parentId":15},{"id":233,"parentId":15},{"id":234,"parentId":16},{"id":235,"parentId":16}]},"version":0.4,"uuid":"6f0b668e-ac59-42b6-9e71-72677cf02600"}