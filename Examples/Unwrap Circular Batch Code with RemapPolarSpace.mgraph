1,"INTERFACE (ITcVnImage)"],[50,"4a3be623-6dd4-4ad7-8bdb-d88c596ba9de",1,"686dfd78-f615-4e3e-bc05-af76ae1b6033",1,"INTERFACE (ITcVnContainer)"],[51,"4a3be623-6dd4-4ad7-8bdb-d88c596ba9de",2,"686dfd78-f615-4e3e-bc05-af76ae1b6033",2,"ALIAS (HRESULT),DINT"],[52,"686dfd78-f615-4e3e-bc05-af76ae1b6033",1,"331c5dba-f69f-4219-8d6c-b7447bf19049",1,"STRING"],[53,"0da8246c-fe87-4baf-a7b4-9727ba34ca0e",1,"4a3be623-6dd4-4ad7-8bdb-d88c596ba9de",1,"INTERFACE (ITcVnImage)"],[54,"0da8246c-fe87-4baf-a7b4-9727ba34ca0e",2,"4a3be623-6dd4-4ad7-8bdb-d88c596ba9de",2,"ALIAS (HRESULT),DINT"],[55,"e24a9013-3bc7-45c4-8b09-1bcc8d4776e6",2,"7b0dd167-82d4-4b99-b5b1-c36f37e66ee0",3,"ALIAS (HRESULT),DINT"],[56,"4a90f590-66c0-40d5-ae5d-ccf46abf9317",2,"e24a9013-3bc7-45c4-8b09-1bcc8d4776e6",3,"ALIAS (HRESULT),DINT"],[57,"686dfd78-f615-4e3e-bc05-af76ae1b6033",2,"a2cd9893-cd86-42ca-9cdc-e5a704680f15",1,"ALIAS (HRESULT),DINT"]],"groups":[{"id":1,"title":"Read Line of Text","bounding":[6220.60546875,53.36135482788086,911,255.5897216796875],"color":"#3f789e","font_size":24,"flags":{},"description":""},{"id":2,"title":"Convert to Grey","bounding":[1266.701171875,75.33650207519531,242,170],"color":"#3f789e","font_size":24,"flags":{},"description":""},{"id":3,"title":"Locate centre of part","bounding":[1532.312255859375,67.83599853515625,1022.2373657226562,1080.9320068359375],"color":"#3f789e","font_size":24,"flags":{},"description":""},{"id":4,"title":"Unwrap the Part","bounding":[2584.281494140625,61.352081298828125,1459.81298828125,556.0379028320312],"color":"#3f789e","font_size":24,"flags":{},"description":""},{"id":5,"title":"Extract batch Code","bounding":[4064.04638671875,56.106990814208984,760.0463256835938,477.79595947265625],"color":"#3f789e","font_size":24,"flags":{},"description":""},{"id":6,"title":"Rescale and Binarise","bounding":[4846.7548828125,50.753658294677734,1362.3770751953125,479.406494140625],"color":"#3f789e","font_size":24,"flags":{},"description":""}],"config":{},"extra":{"filemeta":{"name":"Unwrap Circular Batch Code with RemapPolarSpace","description":"This graph reads a batch code arranged around a circular part from an embedded image. It extracts channel zero, applies inverted Otsu thresholding, fills holes, detects blobs, and calculates the first contour’s centre of mass. That centre drives bilinear remapping of the channel image into polar space. A predefined rectangular region extracts the code, which is rotated 270 degrees. Resizing preserves its width and halves its height using nearest neighbour interpolation. Otsu tozero thresholding prepares the result for OCR with the numbers and uppercase letters model. The graph exports the first text subcontainer and displays intermediate images, text, and status.","tags":[]},"annotations_plugin":[],"ds":{"scale":0.4736244074476703,"offset":[-3135.246425581037,532.0093822559809]}},"version":0.4,"uuid":"19db2f6b-8a18-4b63-94ae-47f94efae73a"}