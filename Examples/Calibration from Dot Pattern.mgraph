868ec91451",1,"b57150b6-e7c0-428e-b514-6830180d07c1",0,"ALIAS (HRESULT),DINT"],[117,"43154adc-7c5e-4da3-b175-8053d1195b25",5,"2a2be22c-90a7-49fc-96ab-aa81a308ddd3",0,"ALIAS (HRESULT),DINT"],[126,"032b1d6f-1a1b-44dd-b380-c9d75a66aafe",0,"1bb2bb2b-f4e4-4395-bc54-a7ca415a2739",0,"INTERFACE (ITcVnContainer)"],[134,"49987e35-e721-4bf6-baff-33ecaa718426",0,"b64bfe49-c202-4e7f-aa69-ef4a17e07746",0,"INTERFACE (ITcVnImage)"],[135,"49987e35-e721-4bf6-baff-33ecaa718426",0,"cc21d5ea-a266-4142-8901-2d50a9339e3a",0,"INTERFACE (ITcVnImage)"],[138,"607d4e70-2678-4d2f-8455-26f5edbd0608",0,"85f016e0-2d0a-432e-a6f0-c8eff99b608b",0,"INTERFACE (ITcVnImage)"],[140,"9cc975fb-1707-4aac-8192-e16069c56e3f",0,"607d4e70-2678-4d2f-8455-26f5edbd0608",0,"INTERFACE (ITcVnImage)"],[141,"a34cb94f-cf3c-4997-95f0-0051a5a6c210",0,"607d4e70-2678-4d2f-8455-26f5edbd0608",1,"INTERFACE (ITcVnImage)"],[142,"838e3e94-883a-45d2-9b09-e6e50cf8a3a5",0,"607d4e70-2678-4d2f-8455-26f5edbd0608",2,"INTERFACE (ITcVnImage)"],[143,"847fd905-2108-48ca-aace-41f5e82ecbf5",0,"607d4e70-2678-4d2f-8455-26f5edbd0608",10,"BYTE"]],"groups":[{"id":2,"title":"Run Time Calculations - Correct a real worlld image","bounding":[3756.387451171875,-468.24139404296875,2373.353759765625,556.4457397460938],"color":"#b58b2a","font_size":24,"flags":{},"description":""},{"id":3,"title":"Calibrate Camera from dots","bounding":[919.6142578125,57.455543518066406,1035.543701171875,1137.058837890625],"color":"#3f789e","font_size":24,"flags":{},"description":""},{"id":4,"title":"Correct for Lens Distortion","bounding":[1997.71044921875,387.19952392578125,689.3087768554688,364.48687744140625],"color":"#3f789e","font_size":24,"flags":{},"description":""},{"id":5,"title":"Derive reference points for the 4 corners of the grid","bounding":[2726.876953125,110.44088745117188,2708.29052734375,636.0846557617188],"color":"#3f789e","font_size":24,"flags":{},"description":""},{"id":6,"title":"Test Correct Calibration Image","bounding":[5460.9072265625,113.2837142944336,678.8207397460938,625.375732421875],"color":"#3f789e","font_size":24,"flags":{},"description":""},{"id":7,"title":"Preprocess Calibration Image","bounding":[-78.41399383544922,374.593017578125,970.6492309570312,390.0513610839844],"color":"#3f789e","font_size":24,"flags":{},"description":""}],"config":{},"extra":{"filemeta":{"name":"Calibration from Dot Pattern","description":"Overview\nThis graph demonstrates a complete two-stage correction process for a camera image. First, a known circle-dot calibration target is used to calculate the camera lens calibration data. Second, the same calibration data and the detected dot-grid corner positions are used to correct a real production image so that a flat object on the same plane appears as a square, top-down view.\n\nThe process separates two different corrections:\n\n1. Lens distortion correction\n   This removes optical distortion caused by the camera lens, such as barrel or pincushion distortion.\n\n2. Perspective correction\n   This removes the apparent trapezium shape caused by viewing a flat plane at an angle.\n\nThe lens correction is performed first. The perspective warp is then applied to the lens-corrected image.\n\n------------------------------------------------------------\n1. Preprocess Calibration Image\n------------------------------------------------------------\n\nThe calibration image contains a regular circle-dot grid on a flat white target.\n\nThe image is first converted or selected as a single-channel 8-bit image suitable for blob and calibration processing. The image is then thresholded so that the circle dots are detected correctly as black filled circles on a white background.\n\nIn this example the calibration image originally had the wrong polarity, so the threshold or image polarity had to be inverted. Once inverted, the calibration function was able to detect the circle grid.\n\nMain functions used in this stage:\n\n- F_VN_GetImageChannel\n- F_VN_Threshold\n\nPurpose:\n\n- Extract a clean grayscale image.\n- Convert the dot pattern into a high-contrast black-on-white calibration target.\n- Ensure the dots are detected with the correct polarity.\n\n------------------------------------------------------------\n2. Generate the Calibration Reference Pattern\n------------------------------------------------------------\n\nA matching ideal reference pattern is generated using the known physical geometry of the dot grid.\n\nFor this graph the calibration pattern is a symmetrical circle grid with:\n\n- Pattern type: TCVN_CP_CIRCLES_SYM\n- Origin: TCVN_CPO_TOPLEFT\n- Width: 14 dots\n- Height: 10 dots\n- X spacing: 20.0\n- Y spacing: 20.0\n\nThis creates 140 reference points.\n\nMain function used:\n\n- F_VN_GenerateCalibrationPatternReferencePoints\n\nPurpose:\n\n- Generate the ideal 2D reference coordinates of the calibration target.\n- These reference points are paired with the detected circle centres from the image during camera calibration.\n\nImportant note:\n\nThe width and height are the number of dot centres, not the number of spaces between dots. A 14 by 10 dot pattern therefore contains 140 points.\n\n------------------------------------------------------------\n3. Calibrate the Camera from the Dot Pattern\n------------------------------------------------------------\n\nThe thresholded dot pattern image, the generated reference points, the blob detection parameters, and the calibration options are passed into the camera calibration function.\n\nMain function used:\n\n- F_VN_CalibrateCamera\n\nInputs:\n\n- Source calibration image\n- Reference pattern points\n- Blob detection parameters\n- Camera calibration options\n\nOutputs:\n\n- Camera matrix\n- Distortion coefficients\n- Rotation matrix\n- Translation vector\n- Reprojection error\n\nThe most important outputs for later image correction are:\n\n- Camera matrix\n- Distortion coefficients\n\nThe reprojection error is used as a quality indicator. A low reprojection error indicates that the detected image points match the generated reference pattern well.\n\nPurpose:\n\n- Calculate the internal camera model.\n- Measure the lens distortion.\n- Produce calibration data that can be reused for future images from the same camera, lens, focus, and working-distance setup.\n\n------------------------------------------------------------\n4. Correct the Calibration Image for Lens Distortion\n------------------------------------------------------------\n\nThe camera matrix and distortion coefficients are then used to remove lens distortion from the calibration image.\n\nMain function used:\n\n- F_VN_CompensateLensDistortionExp1\n\nInputs:\n\n- Source image\n- Camera matrix\n- Distortion coefficients\n\nOutput:\n\n- Lens-distortion-corrected image\n\nPurpose:\n\n- Remove optical lens distortion.\n- Produce a corrected image that still has perspective distortion if the target is viewed at an angle.\n\nImportant note:\n\nLens correction does not make the dot grid appear square and top-down. It only removes lens distortion. The target will still look trapezoidal if it is tilted relative to the camera.\n\n------------------------------------------------------------\n5. Derive Reference Points for Perspective Correction\n------------------------------------------------------------\n\nA second part of the graph detects the dot positions from the lens-corrected image. The dot contours are found, and the centres of selected corner dots are extracted.\n\nMain functions used:\n\n- F_VN_DetectBlobs\n- F_VN_GetAt_ITcVnContainer\n- F_VN_ContourCenterOfMass or equivalent contour-centre function\n- LREAL_TO_REAL conversions\n\nThe four source points are the pixel coordinates of the four outer dot centres in the corrected camera image.\n\nThe order used must be consistent:\n\n1. Top-left\n2. Top-right\n3. Bottom-right\n4. Bottom-left\n\nThese four points form the source point array for the perspective transform.\n\nPurpose:\n\n- Find where the calibration plane corners appear in the camera image.\n- Use the dot centres as reliable reference points for the flat plane.\n\nImportant note:\n\nThe source points must be measured from the same image that will be warped. If the image has first been lens corrected, the source points must also come from the lens-corrected image.\n\n------------------------------------------------------------\n6. Define the Destination Points\n------------------------------------------------------------\n\nThe destination points define where the four selected source points should appear in the final corrected image.\n\nFor example, the four destination points can define a rectangular top-down coordinate system:\n\n1. Top-left destination point\n2. Top-right destination point\n3. Bottom-right destination point\n4. Bottom-left destination point\n\nThe order must match the source point order exactly.\n\nExample destination layout:\n\n- Top-left:      100, 100\n- Top-right:     1400, 100\n- Bottom-right:  1400, 900\n- Bottom-left:   100, 900\n\nPurpose:\n\n- Define the desired square or rectangular output plane.\n- Control the scale, position, and margin of the corrected result.\n\nImportant note:\n\nIf the point order is wrong, the perspective transform will fold, twist, or squash the image. The most common error is swapping the bottom-left and bottom-right source points.\n\n------------------------------------------------------------\n7. Calculate the Perspective Transformation\n------------------------------------------------------------\n\nThe four source points and four destination points are passed into the perspective transformation function.\n\nMain function used:\n\n- F_VN_GetPerspectiveTransformation\n\nInputs:\n\n- Source points from the camera image\n- Destination points in the desired output image\n\nOutput:\n\n- Perspective transformation matrix\n\nPurpose:\n\n- Calculate the homography that maps the tilted calibration plane onto a flat rectangular output plane.\n\n------------------------------------------------------------\n8. Apply the Correction to a Real Production Image\n------------------------------------------------------------\n\nThe production image contains a real object, such as a flat circuit board, placed on the same plane as the calibration dot board.\n\nThe same correction chain is applied to the production image:\n\n1. Apply lens distortion correction using the stored camera matrix and distortion coefficients.\n2. Apply the perspective warp using the previously calculated perspective transformation matrix.\n\nMain functions used:\n\n- F_VN_CompensateLensDistortionExp1\n- F_VN_WarpPerspective\n\nPurpose:\n\n- Correct the real-world image using the calibration data derived from the dot pattern.\n- Transform the angled camera view into a top-down corrected image.\n- Make objects lying on the calibration plane appear square and correctly proportioned.\n\n------------------------------------------------------------\n9. Test the Perspective Correction on the Calibration Image\n------------------------------------------------------------\n\nThe graph also applies the same perspective transform back to the dot-grid calibration image.\n\nThis produces a corrected dot pattern that appears as a regular square grid.\n\nPurpose:\n\n- Visually confirm that the source and destination points are correct.\n- Confirm that the point order is correct.\n- Confirm that the perspective transform is working before applying it to production images.\n\nIf the corrected dot grid appears square and evenly spaced, the same transform can be applied to any flat object lying on the same plane.\n\n------------------------------------------------------------\n10. Final Output\n------------------------------------------------------------\n\nThe final output is a corrected production image where:\n\n- Lens distortion has been removed.\n- Perspective distortion has been removed.\n- The flat object on the calibration plane appears as a rectangular top-down view.\n\nThis corrected image is then suitable for measurement, inspection, location, or further image processing.\n\n------------------------------------------------------------\nKey Practical Rules\n------------------------------------------------------------\n\n- Calibrate using black filled circles on a white background, or invert the threshold if required.\n- The generated reference pattern must match the real dot grid exactly.\n- Use the correct number of dots, not the number of gaps.\n- Use the camera matrix and distortion coefficients for lens correction.\n- Lens correction does not remove perspective distortion.\n- Use four matching source and destination points for perspective correction.\n- Keep the point order identical in both arrays: top-left, top-right, bottom-right, bottom-left.\n- Source points must come from the same image stage that is being warped.\n- The circuit board or production object must lie on the same plane as the calibration target.\n- If the camera, lens, focus, working distance, or target plane changes, recalibration or a new perspective transform may be required.\n\n------------------------------------------------------------\nShort Process Summary\n------------------------------------------------------------\n\nCalibration dot image -> grayscale/threshold/invert -> generate 14 x 10 circle-grid reference points -> calibrate camera -> obtain camera matrix and distortion coefficients -> compensate lens distortion -> detect four corner dot centres -> define rectangular destination points -> calculate perspective transformation -> warp the corrected image -> apply the same lens and perspective correction to the production image.","tags":[]},"annotations_plugin":[],"ds":{"scale":0.7627768444385479,"offset":[-3573.310649157662,745.0609889388888]},"reroutes":[{"id":1,"pos":[277.4429931640625,28.504915237426758],"linkIds":[135]},{"id":2,"parentId":1,"pos":[2003.4107666015625,48.143348693847656],"linkIds":[135]}],"linkExtensions":[{"id":135,"parentId":2}]},"version":0.4,"uuid":"828aed1a-2202-4f6c-aa0c-9902e6920e1d"}