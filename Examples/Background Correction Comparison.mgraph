ype":"ALIAS (HRESULT),DINT","links":[214]}],"properties":{"fThreshold":0,"fMaxValue":255,"eThresholdType":"TCVN_TT_OTSU_BINARY"},"extra":{"widget_data":{}}}],"links":[[15,"1bf94082-10b1-42c9-8103-c29f5a2a7140",0,"35a5a839-6479-4813-bd2d-b692d0bdfa9e",0,"ALIAS (TcVnVector4_LREAL),ARRAY (ARRAY [0..3] OF LREAL)"],[17,"1bf94082-10b1-42c9-8103-c29f5a2a7140",0,"404aaf78-a07a-4c73-97fa-9b1abc529bc8",0,"ALIAS (TcVnVector4_LREAL),ARRAY (ARRAY [0..3] OF LREAL)"],[26,"0e93c4f4-a5d6-4bc6-92f5-5f8770579b94",0,"6d97b69d-6365-4919-b7c8-92bac6512bc6",0,"INTERFACE (ITcVnImage)"],[28,"0e93c4f4-a5d6-4bc6-92f5-5f8770579b94",1,"6d97b69d-6365-4919-b7c8-92bac6512bc6",1,"ALIAS (HRESULT),DINT"],[70,"559b2a84-d8f2-4ca8-888a-c547a4687610",1,"1bf94082-10b1-42c9-8103-c29f5a2a7140",1,"ALIAS (HRESULT),DINT"],[93,"fb876b1c-3dd2-4331-a2cd-4c0ed9466972",0,"62618d8f-023e-4c18-8293-a528ab1f6a4b",1,"INTERFACE (ITcVnImage)"],[94,"62618d8f-023e-4c18-8293-a528ab1f6a4b",0,"a82ae4b6-04a8-4e5f-8984-fe590b802cea",0,"INTERFACE (ITcVnImage)"],[95,"62618d8f-023e-4c18-8293-a528ab1f6a4b",1,"a82ae4b6-04a8-4e5f-8984-fe590b802cea",1,"ALIAS (HRESULT),DINT"],[96,"a82ae4b6-04a8-4e5f-8984-fe590b802cea",0,"e616eae9-bca4-481b-8799-f92e36a2866d",0,"INTERFACE (ITcVnImage)"],[126,"16979565-498e-4891-bbf3-c1a5b59904a8",0,"20abe76e-1aca-4ef5-9ad9-a5b85b59de3b",0,"INTERFACE (ITcVnImage)"],[130,"5a444348-66b0-4d9f-99d9-ed0316be8ee9",0,"027d1fbd-e75a-4f6f-90e9-b32a28f162fa",0,"INTERFACE (ITcVnImage)"],[133,"16979565-498e-4891-bbf3-c1a5b59904a8",0,"5a444348-66b0-4d9f-99d9-ed0316be8ee9",1,"INTERFACE (ITcVnImage)"],[135,"03423c4a-4f88-4536-b775-c8223526981e",0,"b1e6e165-4a9d-46e9-bc54-2b39269c42b2",0,"ALIAS (TcVnVector4_LREAL),ARRAY (ARRAY [0..3] OF LREAL)"],[136,"03423c4a-4f88-4536-b775-c8223526981e",0,"be122a6e-cc72-4ecc-b728-9460609e4c20",0,"ALIAS (TcVnVector4_LREAL),ARRAY (ARRAY [0..3] OF LREAL)"],[139,"be122a6e-cc72-4ecc-b728-9460609e4c20",0,"16979565-498e-4891-bbf3-c1a5b59904a8",2,"LREAL"],[147,"5a444348-66b0-4d9f-99d9-ed0316be