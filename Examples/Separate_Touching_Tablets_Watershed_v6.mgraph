RESULT)"],[16,"d8797051-0e30-4181-9046-58e61c836b39",2,"3362f806-5cbe-4cf3-a34a-0dbe77524189",1,"DINT"],[18,"d8797051-0e30-4181-9046-58e61c836b39",1,"3d6061aa-6718-44fb-b1e5-4e86c9ae45cd",2,"INTERFACE (ITcVnImage)"],[19,"d8797051-0e30-4181-9046-58e61c836b39",3,"3d6061aa-6718-44fb-b1e5-4e86c9ae45cd",3,"ALIAS (HRESULT)"],[22,"fcbbb1e5-944a-4674-81db-3c26142c756d",1,"82db7d76-3811-438f-a646-c8c8a45e8100",1,"INTERFACE (ITcVnImage)"],[25,"fcbbb1e5-944a-4674-81db-3c26142c756d",1,"3d6061aa-6718-44fb-b1e5-4e86c9ae45cd",1,"INTERFACE (ITcVnImage)"],[70,"ce4db73f-035d-4973-80ec-04dfb65ad5e6",1,"cd0fd6b6-d5a2-480a-829e-5e1576ba2db6",1,"INTERFACE (ITcVnImage)"],[77,"3d6061aa-6718-44fb-b1e5-4e86c9ae45cd",1,"ce4db73f-035d-4973-80ec-04dfb65ad5e6",1,"INTERFACE (ITcVnImage)"],[85,"3d6061aa-6718-44fb-b1e5-4e86c9ae45cd",2,"ce4db73f-035d-4973-80ec-04dfb65ad5e6",2,"ALIAS (HRESULT),DINT"],[86,"ce4db73f-035d-4973-80ec-04dfb65ad5e6",2,"c7df66d9-30a7-42f3-a51d-cfb5e7ec348f",1,"ALIAS (HRESULT),DINT"],[87,"3dfddc2f-800f-4e48-9e58-135d66b3dcbf",1,"9be49a59-3082-4a35-9ed3-5d69b415cad0",1,"INTERFACE (ITcVnImage)"],[88,"9be49a59-3082-4a35-9ed3-5d69b415cad0",1,"165bb1c0-f1b4-4f90-8dbe-fd12c5e5e4fe",1,"INTERFACE (ITcVnImage)"]],"groups":[{"id":1,"title":"1 – Input Image","bounding":[-1608.3355712890625,-153.71278381347656,328,394.1643981933594],"font_size":24,"flags":{},"description":"Source image for the example. The image contains multiple bright tablets on a dark background, with several tablets touching each other."},{"id":2,"title":"2 – Create Foreground Mask","bounding":[-1160.822998046875,-259.5411071777344,414.8064880371094,761.5410766601562],"font_size":24,"flags":{},"description":"Convert the RGB source image to grayscale, then threshold it to separate the bright tablets from the dark background. Touching tablets will still form merged foreground regions at this stage."},{"id":3,"title":"3 – Calculate Distance Transform","bounding":[-704.3056030273438,-255.20497131347656,328,695.25732421875],"font_size":24,"flags":{},"description":"Calculate the distance of each foreground pixel from the nearest background pixel. Pixels near the centres of the tablets obtain larger values, creating peaks that can be used to define markers."},{"id":4,"title":"4 – Generate Watershed Markers","bounding":[-339.87860107421875,-260.8605651855469,328,1041.2255859375],"font_size":24,"flags":{},"description":"Threshold the distance-transform image to retain the central regions of the tablets. Convert the resulting image to USINT and use connected-components labelling to create one DINT marker label for each seed region."},{"id":5,"title":"5 – Separate Touching Tablets","bounding":[46.36471939086914,-262.5255126953125,328,385.9289245605469],"font_size":24,"flags":{},"description":"Apply marker-based watershed segmentation using the original 3-channel image and the connected-component marker image. The watershed result assigns separate labels to touching objects where the marker generation is successful."}],"config":{},"extra":{"__aiIds":{"5abc2c3e-d8b9-4647-879e-c992dcdef51c":"src","7d3e0085-77bd-4852-b751-3a772ae2a05d":"src_display","82db7d76-3811-438f-a646-c8c8a45e8100":"gray","1c309474-77be-4ccb-b00e-01487e652cc8":"fg","b5879e15-3ecd-4394-91a1-fc4d8013f5a2":"fg_display","3dfddc2f-800f-4e48-9e58-135d66b3dcbf":"dist","165bb1c0-f1b4-4f90-8dbe-fd12c5e5e4fe":"dist_display","e00d3d2b-71ce-4aa9-a697-3012a23b6f5c":"seed_thresh","71c97011-05fb-47d5-a11d-283e2266b94a":"seed_u8","7060e0ca-d464-4e36-a4ab-43abe9ae57e5":"seed_display","d8797051-0e30-4181-9046-58e61c836b39":"cc","3362f806-5cbe-4cf3-a34a-0dbe77524189":"seed_count","3d6061aa-6718-44fb-b1e5-4e86c9ae45cd":"watershed","0500364d-efb9-444f-b709-74852a66f1be":"result_display"},"filemeta":{"name":"Separate_Touching_Tablets_Watershed_v6","description":"This example demonstrates how to separate and count touching tablets using marker-based watershed segmentation. The colour image is converted to greyscale and thresholded to distinguish bright tablets from the dark background. A distance transform identifies pixels furthest from each tablet’s boundary, producing peaks near their centres. Thresholding these peaks creates individual markers, which are labelled using connected components. Watershed segmentation then uses these markers and the original image to divide touching tablets into separate regions. The displayed result contains 26 labelled objects. This approach supports individual tablet counting and subsequent measurements when simple thresholding would merge neighbouring tablets together.","tags":[]},"annotations_plugin":[],"ds":{"scale":0.6934334949441332,"offset":[1339.181346621128,421.885517727757]},"reroutes":[{"id":1,"pos":[-1197.608154296875,-302.9407958984375],"linkIds":[25]},{"id":2,"parentId":1,"pos":[-9.864969253540039,-301.81817626953125],"linkIds":[25]}],"linkExtensions":[{"id":25,"parentId":2}]},"version":0.4,"uuid":"2929a512-5eef-4ac7-8c20-5ffc7a53a55c"}