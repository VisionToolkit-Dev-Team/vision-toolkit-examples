3e1f-fefa-4e94-bea8-244ff6e86e26",1,"INTERFACE (ITcVnImage)"],[4,"75a93e1f-fefa-4e94-bea8-244ff6e86e26",1,"1644b50f-b6f8-4a2c-9368-1034b2396971",1,"INTERFACE (ITcVnImage)"],[6,"2e98ca76-0cdb-4bd8-b296-f37ef07af7ed",1,"4e990f7d-c377-4120-8330-07f34a66a183",1,"INTERFACE (ITcVnImage)"],[7,"4e990f7d-c377-4120-8330-07f34a66a183",1,"ad7396e4-057b-421a-addc-6fcd837718cc",1,"INTERFACE (ITcVnImage)"],[15,"1bfe7048-f623-4e0f-a553-bac6d6272226",1,"476d4e99-6b3b-4bbb-b54f-54543875330b",1,"INTERFACE (ITcVnImage)"],[16,"1bfe7048-f623-4e0f-a553-bac6d6272226",1,"2e98ca76-0cdb-4bd8-b296-f37ef07af7ed",1,"INTERFACE (ITcVnImage)"],[17,"55a2bd06-5696-47e7-8aa4-ebe5a62adfbf",1,"50fe8283-358f-400d-a435-844b256d9fb6",1,"INTERFACE (ITcVnImage)"],[18,"50fe8283-358f-400d-a435-844b256d9fb6",1,"3882ec3e-b3c8-4d2e-a796-badee9c7de2c",1,"INTERFACE (ITcVnImage)"],[19,"eecfbcb7-3e14-4101-830a-c5d2b4b6290e",1,"55a2bd06-5696-47e7-8aa4-ebe5a62adfbf",1,"INTERFACE (ITcVnImage)"],[20,"34be44d5-a1fd-41a0-9735-cfa2706716ab",1,"20947540-931e-4778-a9a2-cf6504b28594",1,"INTERFACE (ITcVnImage)"],[21,"42a2fee5-0c7c-4a7e-9204-816806a5b500",1,"34be44d5-a1fd-41a0-9735-cfa2706716ab",1,"INTERFACE (ITcVnImage)"],[22,"eecfbcb7-3e14-4101-830a-c5d2b4b6290e",1,"42a2fee5-0c7c-4a7e-9204-816806a5b500",1,"INTERFACE (ITcVnImage)"]],"groups":[{"id":1,"title":"Input","bounding":[-666.2180786132812,140.48410034179688,426.7038269042969,782.0191040039062],"font_size":24,"flags":{},"description":"Synthetic color camera images, and synthetic grayscale target with corners, edges, lines, circles and high-frequency texture."},{"id":2,"title":"Walsh Code Method","bounding":[388.5794372558594,-121.80097961425781,925.8955078125,651.4324951171875],"font_size":24,"flags":{},"description":"F_VN_SalientFeatures using TCVN_SFM_WALSH_CODE, followed by normalization for easier viewing."},{"id":3,"title":"Sobel Method","bounding":[389.83673095703125,564.9552001953125,926.06494140625,681.8765869140625],"font_size":24,"flags":{},"description":"F_VN_SalientFeatures using TCVN_SFM_SOBEL, followed by normalization for easier viewing."},{"id":4,"title":"TL:DR","bounding":[-669.583251953125,-191.58970642089844,864.58056640625,274.425048828125],"color":"#3f789e","font_size":24,"flags":{},"description":"The purpose of F_VN_SalientFeatures is to highlight the parts of an image that contain strong visual information.\n\nIn practice, it produces a saliency image where areas with significant changes in intensity, edges, corners, texture, or structural detail stand out more strongly than flat or uniform regions.\n\nThis is useful as a preprocessing step when you want to identify visually interesting regions before performing further analysis. For example, it can help with object localisation, feature-based inspection, alignment, defect detection, or deciding which parts of an image deserve more detailed processing.\n\nThe Walsh Code and Sobel methods use different approaches to calculate this feature response, so comparing them can help determine which method gives the most useful result for a particular application."}],"config":{},"extra":{"__aiIds":{"eecfbcb7-3e14-4101-830a-c5d2b4b6290e":"src","4ab48c61-a721-4186-96c1-6cc58d93cb0e":"input_display","476d4e99-6b3b-4bbb-b54f-54543875330b":"walsh","75a93e1f-fefa-4e94-bea8-244ff6e86e26":"walsh_norm","1644b50f-b6f8-4a2c-9368-1034b2396971":"walsh_display","2e98ca76-0cdb-4bd8-b296-f37ef07af7ed":"sobel","4e990f7d-c377-4120-8330-07f34a66a183":"sobel_norm","ad7396e4-057b-421a-addc-6fcd837718cc":"sobel_display"},"filemeta":{"name":"Salient Feature Detection – Walsh Code vs Sobel","description":"Demonstrates F_VN_SalientFeatures using both the Walsh Code and Sobel methods on the same input image. The resulting saliency images are normalized and displayed side by side, making it easy to compare how each method highlights visually significant edges, corners, and image structure.","tags":[]},"annotations_plugin":[],"ds":{"scale":0.5730855330116807,"offset":[1087.6026303266292,328.60471680413275]}},"version":0.4,"uuid":"691d9610-653a-463e-98e2-d28719f8076a"}