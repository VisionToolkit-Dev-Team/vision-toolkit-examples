-4b69-aab5-71acbc903d74",1,"c809a5f9-70dd-40a2-bb0c-50ac59bfc965",1,"LREAL"],[10,"acb18e71-a368-4b19-935d-695c9bdd44a5",1,"c809a5f9-70dd-40a2-bb0c-50ac59bfc965",2,"LREAL"],[11,"c809a5f9-70dd-40a2-bb0c-50ac59bfc965",1,"8660978a-8425-40af-b437-fb50e1f447bc",1,"LREAL"],[12,"8804495a-f7e0-4d0a-9f4e-175721b3f901",1,"3e1d5b46-136f-4aab-8ffc-2f657e0b857c",1,"INTERFACE (ITcVnImage)"],[13,"193f63ca-1411-44ed-ad29-6fda5adfe9c4",1,"83b8fa50-7a61-48c2-a722-39ccbae0a237",1,"INTERFACE (ITcVnContainer)"],[14,"3e1d5b46-136f-4aab-8ffc-2f657e0b857c",1,"83b8fa50-7a61-48c2-a722-39ccbae0a237",2,"INTERFACE (ITcVnImage)"],[15,"16169143-74c6-4f4b-8b93-b23b8866796c",1,"83b8fa50-7a61-48c2-a722-39ccbae0a237",3,"ALIAS (TcVnVector4_LREAL),ARRAY (ARRAY [0..3] OF LREAL)"],[16,"193f63ca-1411-44ed-ad29-6fda5adfe9c4",1,"6e7ef72b-c03c-4e4c-9f05-a2a40b51bcf7",1,"INTERFACE (ITcVnContainer)"],[17,"83b8fa50-7a61-48c2-a722-39ccbae0a237",1,"6e7ef72b-c03c-4e4c-9f05-a2a40b51bcf7",2,"INTERFACE (ITcVnImage)"],[18,"ad6ff4f3-abc3-4099-b6a1-2007ab6ef185",1,"6e7ef72b-c03c-4e4c-9f05-a2a40b51bcf7",3,"ALIAS (TcVnVector4_LREAL),ARRAY (ARRAY [0..3] OF LREAL)"],[19,"6e7ef72b-c03c-4e4c-9f05-a2a40b51bcf7",1,"3b3d05b5-a533-4ea9-95bc-d77cf8afc7bb",1,"INTERFACE (ITcVnImage)"]],"groups":[{"id":1,"title":"1. Find the carton's straight edges (F_VN_HoughLinesExp)","bounding":[584,41.29999542236328,1895.974609375,677.6000366210938],"color":"#3f789e","font_size":24,"flags":{},"description":"Canny turns the image into a binary edge map, then F_VN_HoughLinesExp finds whole straight lines in it. Each line comes back as [distance from origin px, angle of its normal rad], strongest (most edge pixels) first. fAngleRes 0.0174533 = 1 degree; nAccuThreshold 120 = a line needs at least 120 edge pixels, which keeps the label text from producing lines."},{"id":2,"title":"2. Rotation from the strongest line","bounding":[2031.974609375,1271.300048828125,1898,329.6000061035156],"color":"#3f789e","font_size":24,"flags":{},"description":"Element 0 is the strongest line (a long side). Its normal angle in degrees, taken mod 90, gives the carton's rotation whichever side was strongest: 102 mod 90 = 12, and a short side (12) gives the same answer."},{"id":3,"title":"3. Draw the result","bounding":[1304,789.300048828125,1800,410],"color":"#3f789e","font_size":24,"flags":{},"description":"F_VN_DrawLines draws Hough lines straight from the container: all of them in yellow, element 0 thick in green."}],"config":{},"extra":{"filemeta":{"name":"Measure Carton Rotation with HoughLinesExp","description":"This example measures how far a carton is rotated on a conveyor using F_VN_HoughLinesExp.","tags":["Edge Detection","Orientation Measurement","Alignment","Packaging","Logistics"]},"__aiIds":{"8804495a-f7e0-4d0a-9f4e-175721b3f901":"img","6bf5f93a-17b8-4fd0-9910-e61010af4e25":"edges","193f63ca-1411-44ed-ad29-6fda5adfe9c4":"hough","228e22cf-bb90-477a-850c-489a79d5d14d":"showLines","734f722d-173f-4648-bdcb-b48dfa9971e3":"first","32064584-5d56-4f3f-94aa-cf28019f16cf":"split","7d6ddac0-16b2-4872-8560-f44294af5d05":"toL","96efcd58-ea30-4b69-aab5-71acbc903d74":"deg","f5d53c72-89ff-4ffd-a007-dbd0ea7ba5f4":"showTheta","acb18e71-a368-4b19-935d-695c9bdd44a5":"ninety","c809a5f9-70dd-40a2-bb0c-50ac59bfc965":"mod","8660978a-8425-40af-b437-fb50e1f447bc":"showRot","3e1d5b46-136f-4aab-8ffc-2f657e0b857c":"rgb","16169143-74c6-4f4b-8b93-b23b8866796c":"cYellow","ad6ff4f3-abc3-4099-b6a1-2007ab6ef185":"cGreen","83b8fa50-7a61-48c2-a722-39ccbae0a237":"drawAll","6e7ef72b-c03c-4e4c-9f05-a2a40b51bcf7":"drawTop","3b3d05b5-a533-4ea9-95bc-d77cf8afc7bb":"out"},"annotations_plugin":[],"ds":{"scale":0.3752760514064742,"offset":[-353.66157949896547,432.007548974818]}},"version":0.4,"uuid":"d46407ea-5f4d-46c6-821f-b813bbc3ef50"}