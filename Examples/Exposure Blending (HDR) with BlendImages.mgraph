,"widget":{"name":"eElementType"},"link":null}],"outputs":[{"name":"onExecuted","type":-1,"links":null},{"name":"ipDestImage","type":"INTERFACE (ITcVnImage)","links":[15]},{"name":"hresult","type":"ALIAS (HRESULT),DINT","links":null}],"title":"To USINT for viewing","properties":{"eElementType":"TCVN_ET_USINT"},"extra":{"widget_data":{}}},{"id":"a3c16ade-ec79-4924-b482-04120e54b9f0","type":"Vision/Basic Image Operations/F_VN_ConvertElementType","pos":[2003.5234375,370.29998779296875],"size":[257.76171875,78],"flags":{},"order":9,"mode":0,"inputs":[{"name":"onTrigger","type":-1,"link":null},{"name":"ipSrcImage","type":"INTERFACE (ITcVnImage)","link":14},{"name":"hrPrev","type":"ALIAS (HRESULT),DINT","link":null},{"name":"eElementType","type":"ENUM (ETcVnElementType),DINT","widget":{"name":"eElementType"},"link":null}],"outputs":[{"name":"onExecuted","type":-1,"links":null},{"name":"ipDestImage","type":"INTERFACE (ITcVnImage)","links":[16]},{"name":"hresult","type":"ALIAS (HRESULT),DINT","links":null}],"title":"To USINT for viewing","properties":{"eElementType":"TCVN_ET_USINT"},"extra":{"widget_data":{}}}],"links":[[1,"61213a6d-4df0-4c78-8b7a-e7eb99f63463",1,"27ae6586-a4dc-47b6-a759-bc315c98c50d",1,"INTERFACE (ITcVnImage)"],[2,"27ae6586-a4dc-47b6-a759-bc315c98c50d",1,"7ca37b4d-6cf7-4391-8933-dda578fbde3a",1,"INTERFACE (ITcVnImage)"],[3,"e866bb71-54ce-4a13-9f01-99924f989dd9",1,"115745d7-c721-4832-9c1b-bd21bd8a7b07",1,"INTERFACE (ITcVnImage)"],[4,"7ca37b4d-6cf7-4391-8933-dda578fbde3a",1,"6b9cdc7a-ef19-4a40-91c1-10ef763caa57",1,"INTERFACE (ITcVnImage)"],[5,"115745d7-c721-4832-9c1b-bd21bd8a7b07",1,"3adb0d12-46ba-48a8-8dd9-1d7d648dd3c5",1,"INTERFACE (ITcVnImage)"],[8,"61213a6d-4df0-4c78-8b7a-e7eb99f63463",1,"52d49635-4e6c-45fb-b11f-bcf37d1faac0",1,"INTERFACE (ITcVnImage)"],[9,"e866bb71-54ce-4a13-9f01-99924f989dd9",1,"52d49635-4e6c-45fb-b11f-bcf37d1faac0",2,"INTERFACE (ITcVnImage)"],[10,"6b9cdc7a-ef19-4a40-91c1-10ef763caa57",1,"52d49635-4e6c-45fb-b11f-bcf37d1faac0",3,"INTERFACE (ITcVnImage)"],[11,"3adb0d12-46ba-48a8-8dd9-1d7d648dd3c5",1,"52d49635-4e6c-45fb-b11f-bcf37d1faac0",4,"INTERFACE (ITcVnImage)"],[12,"52d49635-4e6c-45fb-b11f-bcf37d1faac0",1,"93d6fdbc-8f21-403f-9716-e2de64b4ca01",1,"INTERFACE (ITcVnImage)"],[13,"6b9cdc7a-ef19-4a40-91c1-10ef763caa57",1,"bc9de66f-3180-4799-813b-5a4de341800a",1,"INTERFACE (ITcVnImage)"],[14,"3adb0d12-46ba-48a8-8dd9-1d7d648dd3c5",1,"a3c16ade-ec79-4924-b482-04120e54b9f0",1,"INTERFACE (ITcVnImage)"],[15,"bc9de66f-3180-4799-813b-5a4de341800a",1,"ec8d17a5-df1a-447f-b1b5-dca169ad41e1",1,"INTERFACE (ITcVnImage)"],[16,"a3c16ade-ec79-4924-b482-04120e54b9f0",1,"2d0cebe4-ff2d-4fe8-8cf6-fe3b58db8e87",1,"INTERFACE (ITcVnImage)"]],"groups":[{"id":1,"title":"1. Two exposures of the same scene","bounding":[584,62.29998779296875,688,1124.5999755859375],"color":"#3f789e","font_size":24,"flags":{},"description":"No single exposure suits this scene: the long one shows the room but burns the window out to white; the short one shows the window (sign GATE 4) but leaves the room almost black."},{"id":2,"title":"2. How well exposed is each pixel?","bounding":[1304,62.699989318847656,1609.046875,445.6000061035156],"color":"#3f789e","font_size":24,"flags":{},"description":"Weights come from the images themselves. Long exposure: weight = 255 - pixel, so blown-out pixels count for nothing. Short exposure: weight = pixel, so pixels lost in the dark count for little. Both are converted to REAL (BlendImages needs 1-channel REAL weights) and smoothed so the switch between exposures has no hard seam. The USINT copies are only for viewing the weights."},{"id":3,"title":"3. Blend (F_VN_BlendImages)","bounding":[2269.5234375,621.300048828125,548,336.6000061035156],"color":"#3f789e","font_size":24,"flags":{},"description":"F_VN_BlendImages computes dest = (src1*w1 + src2*w2) / (w1 + w2) per pixel. Each region is taken mostly from the exposure that captured it best, so the box labels and the window sign are both readable in one image."}],"config":{},"extra":{"filemeta":{"name":"Exposure Blending (HDR) with BlendImages","description":"This example combines a long and a short exposure of the same scene into one image where both the dark room and the bright window are readable, using F_VN_BlendImages.","tags":["Preprocessing for Inspection","High Dynamic Range","Image Enhancement"]},"__aiIds":{"61213a6d-4df0-4c78-8b7a-e7eb99f63463":"long","e866bb71-54ce-4a13-9f01-99924f989dd9":"short","27ae6586-a4dc-47b6-a759-bc315c98c50d":"notLong","7ca37b4d-6cf7-4391-8933-dda578fbde3a":"wLongR","115745d7-c721-4832-9c1b-bd21bd8a7b07":"wShortR","6b9cdc7a-ef19-4a40-91c1-10ef763caa57":"wLong","3adb0d12-46ba-48a8-8dd9-1d7d648dd3c5":"wShort","ec8d17a5-df1a-447f-b1b5-dca169ad41e1":"showWLong","2d0cebe4-ff2d-4fe8-8cf6-fe3b58db8e87":"showWShort","52d49635-4e6c-45fb-b11f-bcf37d1faac0":"blend","93d6fdbc-8f21-403f-9716-e2de64b4ca01":"out","bc9de66f-3180-4799-813b-5a4de341800a":"viewWLong","a3c16ade-ec79-4924-b482-04120e54b9f0":"viewWShort"},"annotations_plugin":[],"ds":{"scale":0.7627768444385465,"offset":[-585.799314249778,107.30340594753488]}},"version":0.4,"uuid":"a4fa263a-ec82-4645-91f8-15f3b44356fe"}